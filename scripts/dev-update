#!/usr/bin/env bash
# Build the daemon and install it as the next version: no manifest, no version bump in Cargo, no
# server. `--major` steps the first number instead of the last. `EMBERLOOP_VERSION=x` pins one.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

if [ -f "$HOME/.cargo/env" ]; then
    . "$HOME/.cargo/env"
fi

# Inside a Session HOME is a harness pi-home, so take the data root from the Session directory.
data_root="${EMBERLOOP_HOME:-}"
if [ -z "$data_root" ] && [ -n "${EMBERLOOP_SESSION_DIR:-}" ]; then
    data_root="$(cd "$EMBERLOOP_SESSION_DIR/../.." && pwd)"
fi
data_root="${data_root:-$HOME/.local/share/emberloop-rs}"

# The installed release names the next one; the build then bakes that version in, so the binary
# and its release directory agree.
version="${EMBERLOOP_VERSION:-$("$data_root/current/emberloop-daemon" update --next-version "$@")}"

EMBERLOOP_BUILD_VERSION="$version" cargo build --release -p emberloop-daemon
reported=$(target/release/emberloop-daemon --version | awk '{print $NF}')
if [ "$reported" != "$version" ]; then
    echo "built binary reports $reported, expected $version" >&2
    exit 1
fi
# Keep the service's ExecStart path on the same build; rename over a running binary.
unit_bin=/usr/local/bin/emberloop-daemon
if [ -w "$unit_bin" ]; then
    cp target/release/emberloop-daemon "$unit_bin.new"
    mv -f "$unit_bin.new" "$unit_bin"
fi
exec target/release/emberloop-daemon update --file target/release/emberloop-daemon
