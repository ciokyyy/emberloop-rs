#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

if [ -f "$HOME/.cargo/env" ]; then
    . "$HOME/.cargo/env"
fi

# The stages below each fan out over every core; on a small VPS that is how the
# check exhausts RAM. Cap build jobs and test workers at what memory can hold
# beyond a 4 GiB reserve for the daemon and its Sessions, 2 GiB per job.
jobs=1
if [ -r /proc/meminfo ]; then
    total_mb=$(awk '/^MemTotal:/ {print int($2 / 1024)}' /proc/meminfo)
    jobs=$(( (total_mb - 4096) / 2048 ))
    cores=$(nproc)
    [ "$jobs" -lt 1 ] && jobs=1
    [ "$jobs" -gt "$cores" ] && jobs=$cores
fi
export CARGO_BUILD_JOBS="$jobs"
export jobs
echo "==> concurrency: $jobs build jobs and test workers"

budgets="scripts/check-budget.tsv"
mkdir -p target

declare -A spent
failures=()
names=()
pids=()

# A stage runs in the background, logs to target/<name>.log and records its
# milliseconds. The caller waits with wait_stage.
run_stage() {
    local name=$1
    shift
    rm -f "target/$name.ms" "target/$name.failed"
    names+=("$name")
    (
        local began
        began=$(date +%s%N)
        if ! "$@" >"target/$name.log" 2>&1; then
            touch "target/$name.failed"
        fi
        echo "$(( ($(date +%s%N) - began) / 1000000 ))" >"target/$name.ms"
    ) &
    pids+=("$!")
}

wait_stage() {
    local pid name
    for pid in "${pids[@]}"; do
        wait "$pid" || true
    done
    for name in "${names[@]}"; do
        spent[$name]=$(cat "target/$name.ms" 2>/dev/null || echo 0)
        if [ -f "target/$name.failed" ]; then
            failures+=("$name")
        fi
    done
    pids=()
    names=()
}

report_failures() {
    local name
    for name in "${failures[@]}"; do
        echo "==> stage $name failed; last 40 lines:"
        tail -40 "target/$name.log"
    done
    [ ${#failures[@]} -eq 0 ]
}

# Independent stages run together; cargo locks its own target dir, so clippy
# and nextest never overlap.
echo "==> fmt, deny and machete"
run_stage fmt cargo fmt --check
run_stage deny cargo deny check
run_stage machete cargo machete
wait_stage

echo "==> clippy"
run_stage clippy cargo clippy --workspace --all-targets -- -D warnings
wait_stage

echo "==> openapi"
run_stage openapi bash -c '
set -e
cargo run -p api --bin dump_openapi
cd web
cp -p src/lib/api/schema.d.ts ../target/schema.d.ts.before
bun run generate:api
# Keep the mtime of an unchanged client, so the web stage stays skippable and the bundle stays
# newer than every web source.
if cmp -s ../target/schema.d.ts.before src/lib/api/schema.d.ts; then
    touch -r ../target/schema.d.ts.before src/lib/api/schema.d.ts
fi
'
wait_stage

echo "==> generated files are committed"
run_stage generated git diff --exit-code -- openapi.json web/src/lib/api/schema.d.ts
wait_stage

# The web stage is the slowest (install, type-check, tests, build) and its whole input is one
# directory tree, so an unchanged tree reuses the green run before it. The stamp is only written
# after the stage passes, and a missing build always runs it, because the daemon embeds web/build.
# web_sources names every path web_bundle.rs calls a source, and the bundle must also stay newer
# than all of them: that test compares modification times, and a checkout rewrites them.
web_sources() {
    printf '%s\n' web/src web/static web/package.json web/svelte.config.js web/vite.config.ts
}

web_inputs() {
    {
        web_sources | while read -r path; do
            if [ -d "$path" ]; then
                find "$path" -type f
            elif [ -e "$path" ]; then
                echo "$path"
            fi
        done
        printf '%s\n' web/bun.lock web/tsconfig.json
    } | sort | xargs -r sha256sum | sha256sum | cut -d' ' -f1
}

web_stale() {
    local changed
    changed="$(find $(web_sources) -newer web/build/index.html -print -quit 2>/dev/null || true)"
    [ -n "$changed" ]
}

web_stamp=target/web-inputs.sha
web_hash="$(web_inputs)"
if [ "$(cat "$web_stamp" 2>/dev/null)" = "$web_hash" ] && [ -f web/build/index.html ] && ! web_stale; then
    echo "==> web unchanged (${web_hash:0:12}); skipped"
else
    echo "==> web"
    run_stage web bash -c 'cd web && bun install --frozen-lockfile && bunx svelte-check --tsconfig ./tsconfig.json --incremental && bunx fallow health --score --min-score 87.9 && bun run test -- --maxWorkers="$jobs" && bun run build'
    wait_stage
    printf '%s\n' "$web_hash" > "$web_stamp"
fi

echo "==> nextest"
run_stage nextest bash -o pipefail -c 'cargo nextest run --workspace --test-threads "$jobs" 2>&1 | tee target/nextest-tests.log'
wait_stage

echo "==> doc tests"
run_stage doc cargo test --doc
wait_stage

echo "==> the slowest tests"
scripts/slow-tests

total=0
printf '%-12s %8s %8s\n' stage ms budget
budget_failures=0
total_budget=""
while IFS=$'\t' read -r stage seconds; do
    [ -z "${stage:-}" ] && continue
    case "$stage" in \#*) continue ;; esac
    if [ "$stage" = total ]; then
        total_budget=$((seconds * 1000))
        continue
    fi
    ms=${spent[$stage]:-0}
    cup=$((seconds * 1000))
    total=$((total + ms))
    printf '%-12s %8d %8d\n' "$stage" "$ms" "$cup"
    if [ "$ms" -gt "$cup" ]; then
        echo "budget exceeded: $stage ${ms}ms > ${cup}ms" >&2
        budget_failures=$((budget_failures + 1))
    fi
done <"$budgets"

if [ -n "$total_budget" ] && [ "$total" -gt "$total_budget" ]; then
    echo "budget exceeded: total ${total}ms > ${total_budget}ms" >&2
    budget_failures=$((budget_failures + 1))
fi

report_failures || exit 1
if [ "$budget_failures" -ne 0 ]; then
    exit 1
fi
echo "==> scripts/check passed cleanly in $(( total / 1000 ))s"
