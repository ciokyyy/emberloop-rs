        "responses": {
          "200": {
            "description": "signed out"
          },
          "404": {
            "description": "unknown account"
          }
        }
      }
    },
    "/api/providers/agy/login": {
      "post": {
        "tags": [
          "crate::providers"
        ],
        "operationId": "start_agy_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginView"
                }
              }
            }
          },
          "409": {
            "description": "a login already runs"
          },
          "503": {
            "description": "the agy server is not installed"
          }
        }
      }
    },
    "/api/providers/agy/login/{id}": {
      "get": {
        "tags": [
          "crate::providers"
        ],
        "operationId": "get_agy_login",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "login id",
            "required": true,
            "schema": {
              "type": "string"
            }
