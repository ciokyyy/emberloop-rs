  "components": {
    "schemas": {
      "AccountView": {
        "type": "object",
        "required": [
          "id",
          "label",
          "tier",
          "signedIn",
          "lastLogin"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "lastLogin": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "signedIn": {
            "type": "boolean"
          },
          "tier": {
            "type": "string"
          }
        }
      },
      "CompleteLoginRequest": {
        "type": "object",
        "required": [
          "address"
        ],
        "properties": {
          "address": {
            "type": "string"
          }
        }
      },
      "CreateProjectRequest": {
        "type": "object",
        "required": [
          "name",
          "root"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "root": {
            "type": "string"
          }
        }
      },
      "CreateSessionRequest": {
        "type": "object",
        "required": [
          "projectId"
        ],
        "properties": {
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "ponytailLevel": {
            "type": [
              "string",
              "null"
            ]
          },
          "projectId": {
            "type": "string"
          },
          "thoughtLevel": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          }
        }
      },
      "LoginView": {
        "type": "object",
        "required": [
          "id",
          "state"
        ],
        "properties": {
          "accountId": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "tier": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "ModelEntry": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "label",
          "kind",
          "efforts",
          "image_input",
          "context_window",
          "source",
          "stale",
          "updated_at"
        ],
        "properties": {
          "context_window": {
            "type": "integer",
            "minimum": 0
          },
          "efforts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "id": {
            "type": "string"
          },
          "image_input": {
            "type": "boolean"
          },
          "kind": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "stale": {
            "type": "boolean"
          },
          "updated_at": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ProjectDto": {
        "type": "object",
        "required": [
          "id",
          "name",
          "root"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "root": {
            "type": "string"
          }
        }
      },
      "PromptDto": {
        "type": "object",
        "required": [
          "id",
          "defaultHash",
          "activeHash",
          "differs"
        ],
        "properties": {
          "activeHash": {
            "type": "string"
          },
          "defaultHash": {
            "type": "string"
          },
          "differs": {
            "type": "boolean"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "overrideHash": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PromptImageDto": {
        "type": "object",
        "required": [
          "mimeType",
          "dataBase64"
        ],
        "properties": {
          "dataBase64": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          }
        }
      },
      "PromptRequest": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PromptImageDto"
            }
          },
          "text": {
            "type": "string"
          }
        }
      },
      "PromptTextDto": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "ProviderView": {
        "type": "object",
        "required": [
          "id",
          "name",
          "signedIn",
          "accounts"
        ],
        "properties": {
          "accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountView"
            }
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "signedIn": {
            "type": "boolean"
          }
        }
      },
      "SessionDto": {
        "type": "object",
        "required": [
          "id",
          "projectId",
          "title",
          "ponytailLevel",
          "model",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "createdAt": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "ponytailLevel": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "thoughtLevel": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "updatedAt": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "SetKeyRequest": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string"
          }
        }
      },
      "Settings": {
        "type": "object",
        "required": [
          "proxy_compression",
          "ponytail_default_level"
        ],
        "properties": {
          "ponytail_default_level": {
            "type": "string"
          },
          "proxy_compression": {
            "type": "boolean"
          }
        }
      },
      "SteerRequest": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
