        }
      },
      "delete": {
        "tags": [
          "crate::providers"
        ],
        "operationId": "cancel_agy_login",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "login id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "canceled"
          },
          "404": {
            "description": "unknown login"
          }
        }
      }
    },
    "/api/providers/agy/login/{id}/complete": {
      "post": {
        "tags": [
          "crate::providers"
        ],
        "operationId": "complete_agy_login",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "login id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginView"
                }
              }
            }
          },
          "400": {
            "description": "the pasted address cannot complete the login"
          },
          "404": {
            "description": "unknown login"
          },
          "409": {
            "description": "the login is not running"
          }
        }
      }
    },
    "/api/providers/opencode-go/key": {
