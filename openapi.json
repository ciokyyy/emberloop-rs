  "components": {
    "schemas": {
      "AccountView": {
        "type": "object",
        "required": [
          "id",
          "label",
          "tier",
          "signedIn",
          "lastLogin"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "lastLogin": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "signedIn": {
            "type": "boolean"
          },
          "tier": {
            "type": "string"
          }
        }
      },
      "CompleteLoginRequest": {
        "type": "object",
        "required": [
          "address"
        ],
        "properties": {
          "address": {
            "type": "string"
          }
        }
      },
      "CreateProjectRequest": {
        "type": "object",
        "required": [
          "name",
          "root"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "root": {
            "type": "string"
          }
        }
      },
      "CreateSessionRequest": {
        "type": "object",
        "required": [
          "projectId"
        ],
        "properties": {
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "ponytailLevel": {
            "type": [
              "string",
              "null"
            ]
          },
          "projectId": {
            "type": "string"
          },
          "thoughtLevel": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          }
        }
      },
      "LoginView": {
        "type": "object",
        "required": [
          "id",
          "state"
        ],
        "properties": {
          "accountId": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": "string"
          },
          "expiresAt": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "id": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "tier": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "userCode": {
            "type": "string"
          },
          "verificationUri": {
            "type": "string"
          }
        }
      },
      "ModelEntry": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "label",
          "kind",
          "efforts",
          "image_input",
          "context_window",
          "source",
          "stale",
          "updated_at"
        ],
        "properties": {
          "context_window": {
            "type": "integer",
            "minimum": 0
          },
          "efforts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "id": {
            "type": "string"
          },
          "image_input": {
            "type": "boolean"
          },
          "kind": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "stale": {
            "type": "boolean"
          },
          "updated_at": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ProjectDto": {
        "type": "object",
        "required": [
          "id",
          "name",
          "root"
        ],
